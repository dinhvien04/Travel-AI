NODE_ENV=development
APP_PORT=8000
API_PREFIX=/api

# External services will be connected later.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCATION_COLLECTION=location_info
QDRANT_IMAGE_COLLECTION=image_collection
QDRANT_TEXT_COLLECTION=text_collection

# Multiple keys are tried in order when Gemini returns quota/rate-limit errors.
GEMINI_API_KEYS=Key1,Key2,Key3
# Optional single-key fallback for older configs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_PRESIGNED_EXPIRES_IN=900
S3_URL_MODE=presigned

TOP_K_DOCS=5
TOP_K_IMAGES=5
IMAGE_MATCH_THRESHOLD=0.75
IMAGE_LOW_CONFIDENCE_THRESHOLD=0.55

# Real embedding models.
# BGE_M3_MODEL uses the Transformers.js-compatible ONNX export of BAAI/bge-m3.
# SIGLIP_MODEL uses the Transformers.js-compatible ONNX export of google/siglip-base-patch16-384.
BGE_M3_MODEL=onnx-community/bge-m3-ONNX
SIGLIP_MODEL=Xenova/siglip-base-patch16-384
BGE_M3_VECTOR_DIM=1024
SIGLIP_IMAGE_VECTOR_DIM=768
SIGLIP_TEXT_VECTOR_DIM=768
EMBEDDING_NORMALIZE=true
TRANSFORMERS_DEVICE=cpu
TRANSFORMERS_DTYPE=
TRANSFORMERS_CACHE_DIR=./.cache/transformers
